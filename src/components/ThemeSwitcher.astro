<button
    type="button"
    class="theme-switcher"
    aria-label="Switch to dark theme"
    aria-pressed="false"
    title="Switch to dark theme"
>
    <svg class="sun" aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
    </svg>
    <svg class="moon" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20.3 15.3A9 9 0 0 1 8.7 3.7a9 9 0 1 0 11.6 11.6Z"></path>
    </svg>
</button>

<script>
    const root = document.documentElement;
    const button = document.querySelector<HTMLButtonElement>("button.theme-switcher");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

    const currentTheme = () =>
        root.dataset.theme ?? (systemTheme.matches ? "dark" : "light");

    const updateButton = () => {
        if (!button) return;

        const isDark = currentTheme() === "dark";
        const nextTheme = isDark ? "light" : "dark";
        const label = `Switch to ${nextTheme} theme`;

        button.setAttribute("aria-pressed", String(isDark));
        button.setAttribute("aria-label", label);
        button.title = label;
    };

    button?.addEventListener("click", () => {
        const theme = currentTheme() === "dark" ? "light" : "dark";
        root.dataset.theme = theme;

        try {
            localStorage.setItem("theme", theme);
        } catch {
            // The switch still works for this page when storage is unavailable.
        }

        updateButton();
    });

    systemTheme.addEventListener("change", updateButton);
    updateButton();
</script>

<style>
    .theme-switcher {
        display: grid;
        width: 1.8rem;
        height: 1.8rem;
        place-items: center;
        padding: 0;
        border: 1px solid var(--ui-2);
        border-radius: 50%;
        background: transparent;
        color: var(--tx);
        cursor: pointer;
    }

    .theme-switcher:hover {
        border-color: var(--cyan);
        color: var(--cyan);
        background-color: var(--bg-2);
    }

    .theme-switcher:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 2px;
    }

    svg {
        width: 1rem;
        height: 1rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.75;
    }

    .moon {
        display: none;
    }

    :global(:root[data-theme="dark"]) .sun {
        display: none;
    }

    :global(:root[data-theme="dark"]) .moon {
        display: block;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme])) .sun {
            display: none;
        }

        :global(:root:not([data-theme])) .moon {
            display: block;
        }
    }
</style>
