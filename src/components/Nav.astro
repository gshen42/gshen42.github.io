---
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<nav>
    <a class="site-name" href="/">Gan Shen</a>
    <ul>
        <li>
            <a href="/writings/"> Writings </a>
        </li>
        <li>
            <a href="/academic/"> Academic </a>
        </li>
        <li>
            <a href="/personal/"> Personal </a>
        </li>
        <li>
            <ThemeSwitcher />
        </li>
    </ul>
</nav>

<style>
    nav {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 6rem;
        white-space: nowrap;
    }

    nav a {
        text-decoration: none;
    }

    nav a:after {
        content: "";
    }

    nav a:hover {
        color: var(--red);
        text-decoration: none;
    }

    ul {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li {
        font-size: 0.9rem;
    }

    @media screen and (max-width: 520px) {
        nav {
            flex-direction: column;
            gap: 0rem;
        }
    }
</style>
