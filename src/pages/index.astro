---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Gan Shen">
    <img
        src="/portrait.jpg"
        alt="A portrait of Gan Shen wearing PhD regalia"
        id="portrait"
    />
    <p>
        Hi there! 👋 Welcome. I'm Gan. I'm an Applied Scientist at Amazon Web
        Services in the <a
            href="https://www.amazon.science/research-areas/automated-reasoning"
        >
            Automated Reasoning Group
        </a>.
    </p>
    <p>
        I'm broadly interested in programming languages, formal methods, and
        software verification, focusing on their applications to building
        reliable and extensible software systems.
    </p>
    <p>
        I received my PhD in Computer Science from UC&nbsp;Santa&nbsp;Cruz,
        where I was advised by my wonderful advisor <a
            href="https://users.soe.ucsc.edu/~lkuper/">Lindsey Kuper</a
        >.
    </p>
    <hr />
    <p>
        You can reach me via <a href="mailto:gan_shen@icloud.com">email</a>, or
        find me on <a href="https://github.com/gshen42">GitHub</a>
        , <a rel="me" href="https://mastodon.social/@ganshen">Mastodon</a>, and <a
            href="https://www.linkedin.com/in/gshen42/">LinkedIn</a
        >.
    </p>
</Layout>

<style>
    #portrait {
        width: 12rem;
        border-radius: 50%;
        margin-bottom: 1.5rem;
    }
</style>
